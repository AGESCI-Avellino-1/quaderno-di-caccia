# Copy to .env (never commit it). Django reads it in development too.
# For production run scripts/configure-prod.sh: it fills in the values marked [prod].

# --- Django ----------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_DEFAULT_FROM_EMAIL=QdC <noreply@example.org>
DJANGO_LOG_LEVEL=INFO

# Development database (compose.dev.yml). In production compose builds it from POSTGRES_*.
DATABASE_URL=postgres://qdc:qdc@localhost:5432/qdc

# --- QdC -------------------------------------------------------------------------
# Public address of the app (used in email links).
QDC_FRONTEND_URL=http://localhost:5173
QDC_INVITO_VALIDITA_GIORNI=14
# Days a phone may keep offline data without reaching the server (DEC-97).
QDC_OFFLINE_GIORNI=14

# --- Login with Google / Apple (optional, DEC-22) ---------------------------------
QDC_GOOGLE_CLIENT_ID=
QDC_GOOGLE_SECRET=
QDC_APPLE_CLIENT_ID=
QDC_APPLE_KEY_ID=
QDC_APPLE_TEAM_ID=
QDC_APPLE_PRIVATE_KEY=

# --- [prod] Email (SMTP) -------------------------------------------------------------
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# --- [prod] Written by scripts/configure-prod.sh -------------------------------------
# COMPOSE_FILE=compose.prod.yml
# QDC_REVERSE_PROXY=nginx-host
# QDC_DOMAIN=qdc.example.org
# QDC_HTTP_PORT=8080
# QDC_PROXY_COUNT=2
# POSTGRES_DB=qdc
# POSTGRES_USER=qdc
# POSTGRES_PASSWORD=
