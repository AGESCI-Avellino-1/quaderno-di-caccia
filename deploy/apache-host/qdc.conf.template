# Apache on the host → QdC containers on 127.0.0.1:${QDC_HTTP_PORT}.
# Generated by scripts/configure-prod.sh. Needs: a2enmod proxy proxy_http headers ssl
# rewrite http2. Certificate: certbot --apache -d ${QDC_DOMAIN}
<VirtualHost *:80>
    ServerName ${QDC_DOMAIN}
    RewriteEngine On
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<VirtualHost *:443>
    ServerName ${QDC_DOMAIN}
    Protocols h2 http/1.1

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/${QDC_DOMAIN}/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/${QDC_DOMAIN}/privkey.pem
    # HSTS is set by the app container (frontend/docker/qdc-sicurezza.conf) and Django.

    LimitRequestBody 20971520
    ProxyPreserveHost On
    ProxyTimeout 120
    RequestHeader set X-Forwarded-Proto "https"

    # The app containers do not answer (DEC-270): Apache's own errors only, the app's
    # answers (the maintenance 503 too) pass untouched (ProxyErrorOverride is off).
    Alias /qdc-errori/ "${QDC_RADICE}/frontend/public/errori/"
    <Directory "${QDC_RADICE}/frontend/public/errori">
        Require all granted
    </Directory>
    ErrorDocument 502 /qdc-errori/50x.html
    ErrorDocument 503 /qdc-errori/50x.html
    ErrorDocument 504 /qdc-errori/50x.html

    ProxyPass        /qdc-errori/ !
    ProxyPass        / http://127.0.0.1:${QDC_HTTP_PORT}/
    ProxyPassReverse / http://127.0.0.1:${QDC_HTTP_PORT}/
</VirtualHost>
