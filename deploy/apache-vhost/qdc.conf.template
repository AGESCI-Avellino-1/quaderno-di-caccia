# Apache on the host, virtual host already created by a control panel (Virtualmin,
# ISPConfig, Plesk…) → QdC containers on 127.0.0.1:${QDC_HTTP_PORT}.
# Generated by scripts/configure-prod.sh. Not a whole virtual host: only directives to add
# to the ones the panel wrote for ${QDC_DOMAIN}. The panel keeps the certificate, the logs
# and the port 80 virtual host. Needs mod_proxy, mod_proxy_http, mod_headers.

# --- Inside <VirtualHost *:443> (HTTPS) ----------------------------------------------
# Everything goes to QdC except /.well-known/, left to the panel for the certificate
# renewal. The panel's DocumentRoot, .htaccess files and PHP are never reached for the
# proxied paths.
# HSTS is set by the app container (frontend/docker/qdc-sicurezza.conf) and Django.
LimitRequestBody 20971520
ProxyPreserveHost On
ProxyTimeout 120
# mod_proxy appends the client address to X-Forwarded-For by itself (QDC_PROXY_COUNT=2):
# do not add other X-Forwarded-For lines.
RequestHeader set X-Forwarded-Proto "https"
# The app containers do not answer (DEC-270): Apache's own errors only, the app's answers
# (the maintenance 503 too) pass untouched (ProxyErrorOverride is off).
Alias /qdc-errori/ "${QDC_RADICE}/frontend/public/errori/"
<Directory "${QDC_RADICE}/frontend/public/errori">
    Require all granted
</Directory>
ErrorDocument 502 /qdc-errori/50x.html
ErrorDocument 503 /qdc-errori/50x.html
ErrorDocument 504 /qdc-errori/50x.html
ProxyPass        /qdc-errori/ !
ProxyPass        /.well-known/ !
ProxyPass        / http://127.0.0.1:${QDC_HTTP_PORT}/
ProxyPassReverse / http://127.0.0.1:${QDC_HTTP_PORT}/

