# Daily jobs of the Quaderno di Caccia (install with `crontab -e` on the host, as the
# user that runs docker/podman compose). Adjust the path to the installation.
#
#   segnala_correzioni     summary of the corrections to forward, to the capigruppo
#   avvisa_maggiore_eta    alerts to members turning 18 and their parents
#   promemoria_iscrizioni  new registration requests, reminders, suspensions
#   emetti_quote           issue the fees whose period has started (monthly fees on the 1st)
#   riassumi_presenze      attendance older than two years becomes yearly totals
#   promemoria_quote       reminders of unpaid fees due within a week
#   promemoria_buonacaccia deadlines of BuonaCaccia registrations, to staff and families
#   promemoria_lista_attesa after two years on the waiting list, asks whether to stay
#   promemoria_verbali     minutes still to write; names kept for five years; broken uploads
#   promemoria_fine_anno   the year to close and who is due for archiving, to the capigruppo
#   backup-db.sh           database and uploaded files, kept 30 days (copy them elsewhere,
#                          encrypted: a backup on the same server is lost with it)
#
# Times are spread out so the emails do not leave all together.
15 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py segnala_correzioni
20 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py avvisa_maggiore_eta
25 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_iscrizioni
5 6 * * *   cd /srv/qdc && docker compose exec -T web python manage.py emetti_quote
40 3 * * *  cd /srv/qdc && docker compose exec -T web python manage.py riassumi_presenze
30 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_quote
35 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_buonacaccia
40 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_lista_attesa
45 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_verbali
50 7 * * *  cd /srv/qdc && docker compose exec -T web python manage.py promemoria_fine_anno
30 2 * * *  cd /srv/qdc && KEEP_DAYS=30 scripts/backup-db.sh > /dev/null
