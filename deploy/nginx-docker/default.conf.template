# nginx-docker mode: the "app" container is the public web server and terminates TLS.
# Certificates are read from ${QDC_CERT_DIR} (default /etc/letsencrypt on the host).
# First certificate: see README, "Produzione → nginx in Docker".
map $scheme $qdc_proto {
    default $scheme;
}

server {
    listen 80;
    server_name ${QDC_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;  # the nginx:stable image is >= 1.25.1
    server_name ${QDC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${QDC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${QDC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    # HSTS is set by the app container (frontend/docker/qdc-sicurezza.conf) and Django.

    include /etc/nginx/qdc/qdc-locations.conf;
}
