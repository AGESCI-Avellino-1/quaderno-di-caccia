# nginx on the host → QdC containers on 127.0.0.1:${QDC_HTTP_PORT}.
# Generated by scripts/configure-prod.sh; install it in /etc/nginx/sites-available/ and
# obtain the certificate with: certbot --nginx -d ${QDC_DOMAIN}
server {
    listen 80;
    listen [::]:80;
    server_name ${QDC_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    # "listen ... http2" instead of "http2 on;": the latter needs nginx >= 1.25.1, while
    # Ubuntu 24.04 ships 1.24 and Debian 12 ships 1.22. Newer nginx only warns.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${QDC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${QDC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${QDC_DOMAIN}/privkey.pem;
    # HSTS is set by the app container (frontend/docker/qdc-sicurezza.conf) and Django.

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:${QDC_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
